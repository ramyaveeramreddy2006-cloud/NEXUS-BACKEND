# Example values only. Configure the database credentials and JWT secret
# in your hosting provider's environment settings, not in a committed .env file.
SPRING_PROFILES_ACTIVE=prod
PORT=8081
DB_URL=jdbc:mysql://YOUR-MYSQL-HOST:3306/YOUR-DATABASE?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=YOUR-DATABASE-USERNAME
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
